NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://pp_user:pp_password@localhost:5432/pp_db

SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Standard-GitLab-URL (Token wird pro Admin in der App hinterlegt)
# GITLAB_URL=https://gitlab.example.com

# Optional: User-Agent für GitLab-API-Anfragen (Default: pp-project-management/<version>).
# Nur ändern, wenn der Bot-Schutz der GitLab-Instanz (z. B. Cloudflare) Anfragen blockiert.
# GITLAB_USER_AGENT=pp-project-management/1.0.0
